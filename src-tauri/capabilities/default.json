{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "process:allow-exit",
    "opener:default",
    "fs:default",
    "dialog:allow-open",
    {
      "identifier": "fs:scope",
      "allow": [
        "**"
      ]
    },
    "dialog:default"
  ]
}